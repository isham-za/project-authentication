# Security Settings
# Generate a secret key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-value-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional: defaults to SQLite if not provided)
# For PostgreSQL: DATABASE_URL=postgresql://dbuser:dbpass@localhost:5432/secure_auth_db
